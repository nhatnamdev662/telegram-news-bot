# Cấu hình bot Telegram — copy thành .env rồi điền giá trị
# Lấy token từ @BotFather: /newbot -> token dạng 123456:ABC...
TELEGRAM_BOT_TOKEN=
# ID chat nhận tin (để trống thì bot tự tìm khi bạn nhắn /start)
TELEGRAM_CHAT_ID=
# User id được phép điều khiển bot bằng lệnh (cách nhau bằng dấu phẩy, để trống = ai cũng dùng được)
ADMIN_IDS=
